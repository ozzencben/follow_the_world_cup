# ==============================================================================
# FollowTheWorldCup.com Backend Environment Variables Template
# ==============================================================================

# Core Project Configuration
PROJECT_NAME="FollowTheWorldCup API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"  # development, staging, production

# Logging Configuration
LOG_LEVEL="DEBUG"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Security & CORS Setup
# Provide origins as a comma-separated list without spaces
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://follow-the-world-cup.vercel.app"

# External Integrations (Stubs for future development)
FOOTBALL_API_KEY="your_football_data_api_key_here"
GEMINI_API_KEY="your_google_gemini_api_key_here"
