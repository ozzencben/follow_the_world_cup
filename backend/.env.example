# ==============================================================================
# FollowTheWorldCup.com Backend Environment Variables Template
# ==============================================================================

# Core Project Configuration
PROJECT_NAME="FollowTheWorldCup API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"  # development, staging, production

# Logging Configuration
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Security & CORS Setup
# BACKEND_CORS_ORIGINS: Comma-separated allowed origins (e.g. Vercel main deployment URL)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://followtheworldcup.com"

# ALLOWED_ORIGINS: Alias for BACKEND_CORS_ORIGINS for strict DevOps consistency
ALLOWED_ORIGINS="https://followtheworldcup.com"

# BACKEND_CORS_ORIGIN_REGEX: Regex pattern for dynamic environments (like Vercel dynamic preview links)
# Note: Escape backslashes properly in production (e.g. https://.*\.vercel\.app -> https://.*\\.vercel\\.app)
BACKEND_CORS_ORIGIN_REGEX="https://.*\\.vercel\\.app"

# Integrations & Redirections
KREOSUS_URL="https://kreosus.com/httpsgithubcomozzencben"

# External FIFA API endpoints
# Externalized to allow dynamic patching without code deployment if FIFA alters their path structures
FIFA_TEAMS_API_URL="https://cxm-api.fifa.com/fifaplusweb/api/sections/teamsModule/4v5Yng3VdGD9c1cpnOIff1?locale=en&limit=200"
FIFA_SQUADS_API_URL="https://play.fifa.com/json/bracket_predictor/squads.json"
FIFA_ROUNDS_API_URL="https://play.fifa.com/json/bracket_predictor/rounds.json"

# Secret Keys & Credentials
FOOTBALL_API_KEY="your_football_data_api_key_here"
GEMINI_API_KEY="your_google_gemini_api_key_here"
