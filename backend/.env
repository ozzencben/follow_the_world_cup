# Core Project Configuration
PROJECT_NAME="FollowTheWorldCup API"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Logging Configuration
LOG_LEVEL="INFO"

# Security & CORS Setup
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://follow-the-world-cup.vercel.app,https://followtheworldcup.com,https://www.followtheworldcup.com"
BACKEND_CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# Integrations & Redirections
KREOSUS_URL="https://kreosus.com/httpsgithubcomozzencben"

# External FIFA API endpoints
